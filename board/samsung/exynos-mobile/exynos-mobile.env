stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

bootdelay=0
bootcmd=mw.l 0x19030070 0x1281 1;
	run b2l_menu_request;
	setenv loadaddr 0x90000000;
	ufs init;
	scsi scan;
	part start scsi 0 31 ud_start;
	part size  scsi 0 31 ud_size;
	blkmap create root;
	blkmap map root 0 0x${ud_size} linear scsi 0 0x${ud_start};
	ls blkmap 0:1;
	run b2l_sd_power_cycle;
	mmc dev 0 || mmc dev 0 || echo "SD card not usable";
	bootefi bootmgr;
	pause;
	bootmenu

fastbootcmd=echo "Fastboot Mode";
	fastboot -l $fastboot_addr_r usb 0

reboot_recovery=mw.l 0x15860810 0xff; 
	mw.l 0x1586080c 0x12345674;
	reset

bootmenu_0=Continue Boot=boot
bootmenu_1=Enter Fastboot Mode=run fastbootcmd
bootmenu_2=UEFI Maintenance Menu=eficonfig
bootmenu_3=Reboot=reset
bootmenu_4=Power Off=poweroff
bootmenu_5=Recovery=run reboot_recovery

/*
 * Requests from systemd-boot (B2lUbootMenu.efi): a marker and its inverse at
 * 0x8F000000, then a warm reset. "B2LM" = show this menu ("Back to U-Boot
 * menu"), "B2LI" = start iOS from the SD card. iOS has to start from here,
 * before UFS is initialised: Mu UEFI hangs on a UFS controller that U-Boot
 * brought up. RAM that did not survive the reset holds no marker, and the
 * normal boot goes on.
 */
b2l_menu_request=if itest.l *0x8f000000 == 0x4d4c3242 && itest.l *0x8f000004 == 0xb2b3cdbd; then
		mw.l 0x8f000000 0 2;
		dcache flush;
		bootmenu;
	fi;
	if itest.l *0x8f000000 == 0x494c3242 && itest.l *0x8f000004 == 0xb6b3cdbd; then
		mw.l 0x8f000000 0 2;
		dcache flush;
		run b2l_ios_sd;
	fi

/*
 * A card that Linux left in 1.8 V signalling survives the MMC core's 2 ms
 * power cycle after a warm reboot and does not answer: keep the card supply
 * (VDD, LDO15) off for 1 s. The I/O supply (LDO2) stays on, as in the MMC
 * core's own power cycle (Mu UEFI hung after both were cycled). Used before
 * the EFI boot manager, so that EFI programs see the card.
 */
b2l_sd_power_cycle=regulator dev sd_vmmc; regulator disable;
	sleep 1;
	regulator dev sd_vmmc; regulator enable

/*
 * beyond2lte-ios from the SD card (mmc 0): partition 1 holds its Android v1
 * boot.img (BootShim + Mu UEFI FD + DTB, B2LXNU02 trailer that XnuLoader
 * reads itself); its root is the HFSX partition b2lroot. Hand over the way
 * S-Boot does: caches and MMU off, jump to BootShim (position independent,
 * copies the FD to 0xC9000000). Started only by the "B2LI" request above.
 */
b2l_ios_sd=mw.l 0x19030070 0x1281 1;
	echo "iOS: SD card power cycle (card supply off for 1 s)";
	run b2l_sd_power_cycle;
	echo "iOS: selecting the SD card (mmc 0)";
	if mmc dev 0 || mmc dev 0; then
		mmc info;
		if part start mmc 0 1 ios_start; then
			echo "iOS: partition 1 starts at block 0x${ios_start}";
			mw.l 0x90000000 0 0x10;
			if mmc read 0x90000000 ${ios_start} 0x4000; then
				setexpr.l ios_magic *0x90000000;
				echo "iOS: first word ${ios_magic} (ANDROID! is 52444e41)";
				if test "${ios_magic}" = "52444e41"; then
					echo "Starting beyond2lte-ios";
					dcache flush; dcache off; icache off;
					go 0x90000800;
				fi;
			else
				echo "iOS: reading the SD card failed";
			fi;
		else
			echo "iOS: no partition 1 on the SD card";
			part list mmc 0;
		fi;
	else
		echo "iOS: the SD card is not usable (mmc dev 0 failed)";
		mmc list;
	fi;
	echo "No iOS boot image in SD card partition 1";
	sleep 15;
	bootmenu

button_cmd_0_name=Volume Down Key
button_cmd_0=mw.l 0x19030070 0x1281 1; bootmenu
